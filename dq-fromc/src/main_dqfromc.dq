/*
 * file:    main_dqfromc.dq
 * brief:   C/C++ to DQ source code translator CLI
 */

use print
use file
use ./code_ast
use ./c_parser

func PrintUsage():
    PrintLn('Usage: dq-fromc <input.c/.cpp/.h> [-o <output.dq>]')
endfunc

func *Main():
    var argc : int = ArgCount()
    if argc < 2:
        PrintUsage()
        exit_code = 1
        return
    endif

    var in_file  : str = ''
    var out_file : str = ''

    var i : int = 1
    while i < argc:
        var arg : str = ArgStr(i)
        if arg == '-o':
            ++i
            if i < argc:
                out_file = ArgStr(i)
            else:
                PrintLn('Error: missing filename after -o')
                exit_code = 1
                return
            endif
        elif arg == '-h' or arg == '--help':
            PrintUsage()
            return
        elif in_file == '':
            in_file = arg
        else:
            PrintLn('Error: unexpected argument: {}', [arg])
            exit_code = 1
            return
        endif
        ++i
    endwhile

    if in_file == '':
        PrintUsage()
        exit_code = 1
        return
    endif

    if not FileExists(in_file):
        PrintLn('Error: input file not found: {}', [in_file])
        exit_code = 1
        return
    endif

    var c_src : str = FileReadText(in_file)
    var parser <- OCParser()
    var root : OCodeNode = parser.ParseFile(c_src)
    var dq_out : str = root.ToDqStr()

    if out_file <> '':
        FileWriteText(out_file, dq_out)
    else:
        Print('{}', [dq_out])
    endif
endfunc
